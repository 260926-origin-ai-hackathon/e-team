# 画面側（ブラウザ）で使う Firebase 設定。公開されても問題ない値だけ置く。コピーして .env にする
# エミュレータで動かすときは API キーは何でもよい（demo-key）
PUBLIC_FIREBASE_API_KEY=demo-key
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=demo-tsugumi
PUBLIC_FIREBASE_APP_ID=
# 空にすると本番 Firebase Auth に接続
PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
